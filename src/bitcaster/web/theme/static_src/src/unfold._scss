@use "colors";
@import "tailwindcss";

@source "../../../templates/unfold/**/*.{html,py,js}";
@source "../../../templates/admin/**/*.{html,py,js}";

div.edit-message-body{
  @apply border-1 ;
  input{
    /* @apply border bg-white min-w-20 rounded shadow-xs text-sm focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 group-[.errors]:border-red-600 focus:group-[.errors]:outline-red-600 dark:group-[.errors]:border-red-500 dark:focus:group-[.errors]:outline-red-500 dark:scheme-dark group-[.primary]:border-transparent px-3 py-2 w-full max-w-2xl;

    ** */
    @apply border bg-white text-sm min-w-20 px-3 py-2 w-full max-w-2xl;
  }
  #edit-message-form {
    table {
      width: 100%;

      td {
        vertical-align: top;
        width: 50%;
      }
    }

    input[type=text], textarea {
      width: 100%;
      border: 1px solid black;
    }

    .address-line {
      display: inline-flex;
      float: right;

      button {

      }

      input#id_recipient {
        width: 200px;
        margin-right: 20px;
      }
    }

    input[type=submit].default {

    }

    h3.title {
      padding: 10px;

    }

    .menubar {
      padding: 5px;

      button {
        &:active {
          color: black;

        }
      }
    }

    .tab {
      display: none;
    }

    #preview {
      border: 1px solid black;
      width: 100%;
      height: 400px;
    }

    .hidden {
      display: none;
    }

    #jsoneditor_id_context {
      width: 100%;
      height: 400px;

      .jse-main {
        height: 100%;

      }

      div.jse-menu.svelte-id9e3c {
        background-color: var(--bg-primary);
      }
    }
  }


}
#content {
  h1 {
    @apply text-2xl text-amber-200;
  }

  .button {
    @apply block border cursor-pointer  px-3 py-2 rounded text-white lg:w-auto;
  }

  .button-primary {
    @apply bg-red-500 border-transparent;
  }
  .button-success {
    @apply bg-green-300 border-transparent;
  }

  .frame {
    @apply border-1 rounded w-full p-2 my-3;
  }
  .frame-warning {
    @apply border-orange-300 text-orange-300;
  }
  .frame-success {
    @apply border-green-300 text-green-300;
  }
}

div.outer_jsoneditor {
  .ace_scroller {
    .ace_content {
      .ace_layer {
        .ace_active-line {
          @apply bg-gray-400;
        }

        .ace_cursor {

        }

        .ace_line {
          .ace_paren, .ace_variable, .ace_constant {
            @apply text-black;
          }
        }
      }
    }
  }

  div.jsoneditor-menu {
    button.jsoneditor-sort, button.jsoneditor-transform, button.jsoneditor-repair {
      display: none;
    }
  }

  .jsoneditor-anchor {
    .jsoneditor-contextmenu-root {
      .jsoneditor-contextmenu {
        ul.jsoneditor-menu {
          @apply bg-gray-600;
          li {
            button {
              @apply bg-transparent;
              &:hover {
                @apply bg-gray-300;
              }

              &.jsoneditor-selected {
                @apply bg-gray-500 text-white font-bold;
              }
            }
          }
        }
      }
    }


    @apply bg-gray-300 text-black;
  }

  .jsoneditor {
    @apply border-gray-700;
    .jsoneditor-menu {
      @apply bg-gray-700;
      button[type=button] {

      }

      .jsoneditor-anchor {
        .jsoneditor-contextmenu {
          @apply bg-gray-400;
          .jsoneditor-menu {
            @apply bg-gray-400;

          }

          button {
            &.jsoneditor-selected {
              @apply bg-amber-50 text-black;
            }
          }
        }
      }

      a.jsoneditor-poweredBy {
        display: none;
      }
    }
  }

}

div.adminfilters {

  &.box {
    h3 {

    }

    .filter-content {
      ul.adminfilter {
        li {
          input[type=text], input[type=date] {
            @apply border p-1 w-full rounded my-4;
          }
        }
      }
    }
  }
}
